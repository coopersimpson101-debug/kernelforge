// Minimal host-C++ stand-in for <metal_stdlib>, used ONLY to syntax/type-check generated MSL on
// machines without Apple's Metal compiler (`python -m ziglang c++ -fsyntax-only -I metal/shim`).
// It models just the subset kernelforge emits. The real check is `xcrun metal` on macOS CI.
#pragma once

#define kernel
#define device
#define constant
#define threadgroup

namespace metal {
typedef unsigned char uchar;
typedef unsigned int uint;
typedef _Float16 half;

struct float2 {
  float x, y;
  float2() : x(0), y(0) {}
  explicit float2(float s) : x(s), y(s) {}
  float2(float a, float b) : x(a), y(b) {}
};
struct float4 {
  float x, y, z, w;
  float4() : x(0), y(0), z(0), w(0) {}
  explicit float4(float s) : x(s), y(s), z(s), w(s) {}
  float4(float a, float b, float c, float d) : x(a), y(b), z(c), w(d) {}
};
#define KF_OP(op)                                                                              \
  inline float4 operator op(float4 a, float4 b) { return float4(a.x op b.x, a.y op b.y, a.z op b.z, a.w op b.w); } \
  inline float4 operator op(float4 a, float b) { return float4(a.x op b, a.y op b, a.z op b, a.w op b); } \
  inline float4 operator op(float a, float4 b) { return float4(a op b.x, a op b.y, a op b.z, a op b.w); }
KF_OP(+) KF_OP(-) KF_OP(*) KF_OP(/)
#undef KF_OP
struct uint3 { uint x, y, z; };

enum class mem_flags { mem_none = 0, mem_device = 1, mem_threadgroup = 2 };
inline void threadgroup_barrier(mem_flags) {}
inline float dot(float4 a, float4 b) { return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w; }
inline float simd_sum(float x) { return x; }
inline float simd_max(float x) { return x; }
inline float rsqrt(float x) { return 1.0f / __builtin_sqrtf(x); }
inline float exp(float x) { return __builtin_expf(x); }
inline float4 exp(float4 v) { return float4(__builtin_expf(v.x), __builtin_expf(v.y), __builtin_expf(v.z), __builtin_expf(v.w)); }
inline float sqrt(float x) { return __builtin_sqrtf(x); }
inline float tanh(float x) { return __builtin_tanhf(x); }
inline float clamp(float x, float lo, float hi) { return x < lo ? lo : (x > hi ? hi : x); }
inline float4 clamp(float4 v, float4 lo, float4 hi) { return float4(clamp(v.x, lo.x, hi.x), clamp(v.y, lo.y, hi.y), clamp(v.z, lo.z, hi.z), clamp(v.w, lo.w, hi.w)); }
inline float4 tanh(float4 v) { return float4(__builtin_tanhf(v.x), __builtin_tanhf(v.y), __builtin_tanhf(v.z), __builtin_tanhf(v.w)); }
inline float fabs(float x) { return __builtin_fabsf(x); }
inline float min(float a, float b) { return a < b ? a : b; }
inline float max(float a, float b) { return a > b ? a : b; }
inline int min(int a, int b) { return a < b ? a : b; }
inline int max(int a, int b) { return a > b ? a : b; }
inline float4 max(float4 a, float4 b) { return float4(max(a.x, b.x), max(a.y, b.y), max(a.z, b.z), max(a.w, b.w)); }
inline float4 min(float4 a, float4 b) { return float4(min(a.x, b.x), min(a.y, b.y), min(a.z, b.z), min(a.w, b.w)); }
}  // namespace metal
